# Identitas grup. Untuk awal, isi TARGET_GROUP_NAME. Setelah bot aktif,
# kirim !idgrup lalu pindahkan nilainya ke TARGET_GROUP_ID agar lebih presisi.
TARGET_GROUP_NAME=Nama Grup Operasional
TARGET_GROUP_ID=

# Kosong berarti semua anggota grup boleh membuat laporan.
# Dapat berupa nomor 62812... atau WhatsApp ID 62812...@c.us, dipisahkan koma.
BOT_ALLOWED_SENDERS=
BOT_COMMAND_PREFIX=!

# Pilih oauth untuk My Drive/akun Google pribadi.
# Pilih service_account hanya jika folder upload berada di Google Shared Drive.
GOOGLE_AUTH_MODE=oauth

# OAuth 2.0 (disarankan untuk My Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/oauth2callback

# Service account (khusus Shared Drive)
GOOGLE_SERVICE_ACCOUNT_JSON=/app/secrets/google-service-account.json

# Ambil ID dari URL Google Sheets dan folder Google Drive.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Data
GOOGLE_DRIVE_FOLDER_ID=

TIMEZONE=Asia/Jakarta
MAX_MEDIA_MB=20
DUPLICATE_SCOPE=day

WA_AUTH_PATH=/app/data/wwebjs-auth
STATE_FILE_PATH=/app/data/state.json
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PORT=8080
LOG_LEVEL=info
