{
  "name": "snap2sheet-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Otomasi laporan foto dari grup WhatsApp ke Google Drive dan Google Sheets.",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "check": "npm run typecheck && npm test",
    "doctor": "tsx scripts/doctor.ts",
    "google:oauth": "tsx scripts/google-oauth.ts",
    "setup": "tsx scripts/setup-wizard.ts",
    "launcher": "tsx scripts/launcher.ts",
    "dashboard": "tsx scripts/dashboard.ts"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "googleapis": "^174.0.1",
    "mime-types": "^3.0.2",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "1.34.7"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.3.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.10",
    "typescript": "^5.9.3"
  }
}
